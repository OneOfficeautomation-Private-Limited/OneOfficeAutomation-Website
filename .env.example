# Settings for the server. Copy this file to .env for local testing.
# On Hostinger, add the same names under your Node.js app's Environment variables instead of uploading .env.

# MySQL database (Hostinger: hPanel → Databases → MySQL Databases)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ooa
DB_USER=ooa
DB_PASSWORD=ooa-local-pass
# Only for hosted databases that require SSL (for example Aiven): paste the CA certificate text.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Signs sign-in sessions. Use a long random value (at least 32 characters) on the live site.
JWT_SECRET=local-development-secret-at-least-32-characters-long

# Needed once, to create the first admin at /admin (at least 16 characters).
ADMIN_SETUP_TOKEN=local-setup-token-1234567890

# Optional. Which proxies to trust for the visitor's IP address (used by the sign-in rate limits).
# The default trusts Hostinger's internal proxies. Only change it if every visitor seems to share one IP.
# TRUST_PROXY=loopback, linklocal, uniquelocal
